#. Plugin Name of the plugin
#: pickup-reminder-for-packeta.php
msgid "Pickup Reminder for Packeta"
msgstr "Připomínka vyzvednutí pro Zásilkovnu"

#. Plugin URI of the plugin
#: pickup-reminder-for-packeta.php
msgid "https://wp.kasparek.app/"
msgstr "https://wp.kasparek.app/"

#. Description of the plugin
#: pickup-reminder-for-packeta.php
msgid "E-mails customers before the last day their Packeta (Zásilkovna) parcel can be picked up, so fewer cash-on-delivery parcels come back. Uses the parcel status and storage date synced by the official Packeta plugin."
msgstr "Pošle zákaznici e-mail před posledním dnem, kdy si může vyzvednout zásilku ze Zásilkovny, takže se vrací méně dobírek. Stav zásilky a úložní dobu bere z oficiálního pluginu Zásilkovny."

#. Author of the plugin
#: pickup-reminder-for-packeta.php
msgid "Jakub Kašpárek"
msgstr "Jakub Kašpárek"

#. Author URI of the plugin
#: pickup-reminder-for-packeta.php
msgid "https://github.com/kasparek-net"
msgstr "https://github.com/kasparek-net"

